# ── Playwright E2E configuration ─────────────────────────────
# Copy to e2e/.env.e2e and fill with your SEEDED STAGING credentials.
# Never commit real secrets.

# Base URL of the running app (seeded staging). Defaults to http://localhost:3000.
E2E_BASE_URL=https://staging.mpproduction.example

# Set to 1 to let Playwright start a local `pnpm --filter web start` instead of
# targeting E2E_BASE_URL (useful for local runs).
# E2E_WEBSERVER=0

# Seeded role credentials. Roles left blank are automatically skipped.
E2E_SUPER_ADMIN_EMAIL=
E2E_SUPER_ADMIN_PASSWORD=

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

E2E_CLIENT_EMAIL=
E2E_CLIENT_PASSWORD=

E2E_TALENT_EMAIL=
E2E_TALENT_PASSWORD=

E2E_EDITOR_EMAIL=
E2E_EDITOR_PASSWORD=

E2E_EMPLOYEE_EMAIL=
E2E_EMPLOYEE_PASSWORD=

E2E_PROJECT_MANAGER_EMAIL=
E2E_PROJECT_MANAGER_PASSWORD=
